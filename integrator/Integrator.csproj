<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Integrator</AssemblyName>
    <RootNamespace>Integrator</RootNamespace>
    <Version>0.7.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Lets the project build (not run) on non-Windows CI/dev machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The test project lives under tests/; keep it out of this app's compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <!-- No NuGet packages: everything is hand-rolled on the .NET base class library. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integrator.Tests" />
    <!-- Embedded so forms/dialogs can use the same icon as the exe + favicon. -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
