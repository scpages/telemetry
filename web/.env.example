# Copy to .env and fill in. All optional except Discord (for real login) and SESSION_SECRET.

# Where the server listens.
HOST=127.0.0.1
PORT=8080

# Public base URL (used for OAuth redirect + links). No trailing slash.
BASE_URL=https://example.com

# Signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# Discord OAuth2 app (https://discord.com/developers/applications).
# Add redirect URI: <BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where the JSON datastore lives.
DATA_FILE=./data/data.json

# Default / max per-account history length.
DEFAULT_HISTORY=100
MAX_HISTORY=1000

# Local testing without Discord: set to 1 to enable /dev-login. Never in production.
ALLOW_DEV_LOGIN=0

# Error reporting to Sentry. Leave SENTRY_DSN blank to disable (default).
# DSN from your Sentry project: Settings -> Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
